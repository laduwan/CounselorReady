// routes/celogs.js - For CE Tracker Display
import express from 'express';
import CELog from '../models/CELog.js';

const router = express.Router();

// Simple auth check
const requireAuth = (req, res, next) => {
  if (!req.user) {
    return res.status(401).json({ success: false, message: 'Not authenticated' });
  }
  next();
};

// Get user's CE logs for tracker
router.get('/', requireAuth, async (req, res) => {
  try {
    const logs = await CELog.find({
      user: req.user._id
    })
    .populate('course', 'title code ceHours category')
    .sort({ completedAt: -1, createdAt: -1 });

    res.json({
      success: true,
      logs: logs.map(log => ({
        _id: log._id,
        course: {
          _id: log.course?._id,
          title: log.course?.title,
          code: log.course?.code,
          ceHours: log.course?.ceHours,
          category: log.course?.category
        },
        ceHours: log.ceHours,
        completed: log.completed,
        completedAt: log.completedAt,
        certificateNumber: log.certificateNumber,
        progress: log.progress,
        createdAt: log.createdAt
      }))
    });
  } catch (error) {
    console.error('Error fetching CE logs:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch CE logs'
    });
  }
});

// Get user's CE summary/stats
router.get('/summary', requireAuth, async (req, res) => {
  try {
    const logs = await CELog.find({
      user: req.user._id,
      completed: true
    }).populate('course', 'ceHours category');

    const totalHours = logs.reduce((sum, log) => sum + (log.ceHours || 0), 0);
    const totalCompleted = logs.length;

    // Group by category
    const byCategory = {};
    logs.forEach(log => {
      const category = log.course?.category || 'Other';
      if (!byCategory[category]) {
        byCategory[category] = { count: 0, hours: 0 };
      }
      byCategory[category].count++;
      byCategory[category].hours += log.ceHours || 0;
    });

    res.json({
      success: true,
      summary: {
        totalHours,
        totalCompleted,
        byCategory
      }
    });
  } catch (error) {
    console.error('Error fetching CE summary:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch CE summary'
    });
  }
});

export default router;
