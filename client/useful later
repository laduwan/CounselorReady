            <button id="copyLoginBtn" onclick="copyLink('${loginUrl}','copyLoginBtn')"
              class="flex items-center gap-1 px-3 py-2 text-xs font-medium rounded-lg bg-burgundy-50 text-burgundy-800 transition-colors hover:bg-burgundy-100">
              <i class="fas fa-copy text-xs"></i> Copy
            </button>
          </div>
        </div>
      `;

      // ── Course Performance ──
      if (stats?.courseBreakdown?.length > 0) {
        const rows = stats.courseBreakdown.map(c => {
          const rateBg = c.completionRate >= 70 ? '#f0fdf4' : c.completionRate >= 40 ? '#fef3c7' : '#fef2f2';
          const rateColor = c.completionRate >= 70 ? '#4A7C59' : c.completionRate >= 40 ? '#d97706' : '#dc2626';
          return `
            <tr class="border-b border-stone-100 last:border-0">
              <td class="py-2.5 px-3 text-stone-900 font-medium">${esc(c.title)}</td>
              <td class="py-2.5 px-3 text-right text-stone-600">${c.enrollments}</td>
              <td class="py-2.5 px-3 text-right text-stone-600">${c.completions}</td>
              <td class="py-2.5 px-3 text-right">
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium" style="background:${rateBg};color:${rateColor}">${c.completionRate}%</span>
              </td>
            </tr>
          `;
        }).join('');

        document.getElementById('coursePerformance').innerHTML = `
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h2 class="text-sm font-semibold text-stone-900 mb-3">Course Performance</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-stone-200">
                    <th class="text-left py-2 px-3 text-xs font-medium text-stone-500">Course</th>
                    <th class="text-right py-2 px-3 text-xs font-medium text-stone-500">Enrollments</th>
                    <th class="text-right py-2 px-3 text-xs font-medium text-stone-500">Completions</th>
                    <th class="text-right py-2 px-3 text-xs font-medium text-stone-500">Rate</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </div>
        `;
        document.getElementById('coursePerformance').classList.remove('hidden');
      }

      // ── Partner Details ──
      let detailsHtml = `
        <h2 class="text-sm font-semibold text-stone-900 mb-3">Partner Details</h2>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class="text-stone-500 text-xs">Slug</dt>
            <dd class="text-stone-900 font-mono">${esc(partner.slug)}</dd>
          </div>
      `;
      if (partner.contact?.email) {
        detailsHtml += `
          <div>
            <dt class="text-stone-500 text-xs">Email</dt>
            <dd class="text-stone-900">${esc(partner.contact.email)}</dd>
          </div>
        `;
      }
      if (partner.contact?.website) {
        const cleanUrl = partner.contact.website.replace(/^https?:\/\//, '');
        detailsHtml += `
          <div>
            <dt class="text-stone-500 text-xs">Website</dt>
            <dd>
              <a href="${esc(partner.contact.website)}" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-1 text-burgundy-800 hover:underline">
                ${esc(cleanUrl)}
                <i class="fas fa-external-link-alt text-xs"></i>
              </a>
            </dd>
          </div>
        `;
      }
      detailsHtml += `
          <div>
            <dt class="text-stone-500 text-xs">Created</dt>
            <dd class="text-stone-900">${new Date(partner.createdAt).toLocaleDateString()}</dd>
          </div>
        </dl>
      `;
      document.getElementById('partnerDetails').innerHTML = detailsHtml;
    }
  </script>
<script src="/js/cr-icons.js"></script>
</body>
