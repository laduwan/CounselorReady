      <select id="stateFilter" onchange="applyFilters()" class="px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white">
        <option value="">All States</option>
      </select>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center py-16">
      <div class="animate-spin rounded-full h-10 w-10 border-4 border-burgundy-200 border-t-burgundy-700 mx-auto mb-4"></div>
