    // ── Auth header helper ──
    function authHeaders() {
      return { 'Authorization': 'Bearer ' + T, 'Content-Type': 'application/json' };
    }

    // ── Init ──
    document.addEventListener('DOMContentLoaded', init);

    async function init() {
      try {
        const res = await fetch(API + '/api/organizations/mine', { headers: authHeaders() });
        if (!res.ok) throw new Error('Failed to load organizations');
        allOrgs = await res.json();

        if (allOrgs.length > 0) {
          selectedOrg = allOrgs[0];
          await loadDashboard(selectedOrg._id);
        }

        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');
        render();
      } catch (err) {
        console.error('Init error:', err);
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');
        render();
      }
    }

    async function loadDashboard(orgId) {
      try {
        const res = await fetch(API + '/api/organizations/' + orgId + '/dashboard', { headers: authHeaders() });
        if (!res.ok) throw new Error('Failed to load dashboard');
        dashboardData = await res.json();
      } catch (err) {
        console.error('Dashboard load error:', err);
        dashboardData = null;
      }
    }

    // ── Render ──
    function render() {
      const emptyState = document.getElementById('emptyState');
      const orgSelector = document.getElementById('orgSelector');
      const statsCards = document.getElementById('statsCards');
      const membersCard = document.getElementById('membersCard');

      if (allOrgs.length === 0) {
        emptyState.classList.remove('hidden');
        orgSelector.classList.add('hidden');
        statsCards.classList.add('hidden');
        membersCard.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      // Org selector (multiple orgs)
      if (allOrgs.length > 1) {
        orgSelector.classList.remove('hidden');
        orgSelector.innerHTML = allOrgs.map(org =>
          `<button onclick="selectOrg('${org._id}')" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors ${selectedOrg && selectedOrg._id === org._id ? 'bg-burgundy-700 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}">
            <i class="fas fa-building mr-1"></i> ${esc(org.name)}
          </button>`
        ).join('');
      } else {
        orgSelector.classList.add('hidden');
      }

      // Stats and members
      if (dashboardData) {
        statsCards.classList.remove('hidden');
        membersCard.classList.remove('hidden');

        const stats = dashboardData.stats || {};
        const members = dashboardData.members || [];

        // Stat values
        const totalMembers = stats.totalMembers || members.length || 0;
        const compliant = stats.compliant || 0;
        const activeMembers = stats.activeMembers || totalMembers;
        const complianceRate = totalMembers > 0 ? Math.round((compliant / totalMembers) * 100) : 0;

        document.getElementById('statTotalMembers').textContent = totalMembers;
        document.getElementById('statActiveMembers').textContent = activeMembers;
        document.getElementById('statComplianceRate').textContent = complianceRate + '%';

        // Members list
        const membersList = document.getElementById('membersList');
        if (members.length === 0) {
          membersList.innerHTML = '<div class="p-8 text-center text-gray-500 text-sm">No team members yet. Invite your first team member above.</div>';
        } else {
          membersList.innerHTML = members.map(member => {
            const statusDot = member.complianceStatus === 'compliant' ? 'bg-green-500'
              : member.complianceStatus === 'at_risk' ? 'bg-yellow-500'
              : 'bg-red-500';

            const roleBadge = member.role === 'admin' || member.role === 'owner'
              ? `<span class="px-2 py-0.5 bg-burgundy-100 text-burgundy-700 text-xs font-medium rounded-full">${esc(member.role)}</span>`
              : `<span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs font-medium rounded-full">${esc(member.role || 'member')}</span>`;

            const statusLabel = member.status === 'active'
              ? '<span class="text-xs text-green-600 font-medium">Active</span>'
              : member.status === 'invited'
                ? '<span class="text-xs text-amber-600 font-medium">Invited</span>'
                : '<span class="text-xs text-gray-400 font-medium">' + esc(member.status || 'active') + '</span>';

            return `
            <div class="p-4 hover:bg-gray-50/50 transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-2.5 h-2.5 rounded-full flex-shrink-0 ${statusDot}"></div>
                  <div>
                    <div class="flex items-center gap-2">
                      <p class="font-medium text-gray-900">${esc(member.name || 'Unnamed')}</p>
                      ${roleBadge}
                    </div>
                    <p class="text-xs text-gray-500">${esc(member.email || '')}</p>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  ${statusLabel}
                  ${member.seatId ? `<button onclick="removeMember('${member.seatId}')" class="p-1.5 text-gray-400 hover:text-red-600 transition-colors" title="Remove member"><i class="fas fa-trash-alt text-sm"></i></button>` : ''}
                </div>
              </div>
            </div>`;
          }).join('');
        }
      } else {
        statsCards.classList.add('hidden');
        membersCard.classList.add('hidden');
      }
    }

    // ── Select Org ──
    async function selectOrg(orgId) {
      selectedOrg = allOrgs.find(o => o._id === orgId);
      await loadDashboard(orgId);
      render();
    }

    // ── Create Organization ──
    document.getElementById('createOrgForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const body = {
        name: document.getElementById('orgName').value,
        type: document.getElementById('orgType').value,
        phone: document.getElementById('orgPhone').value,
        website: document.getElementById('orgWebsite').value,
        address: {
          street: document.getElementById('orgStreet').value,
          city: document.getElementById('orgCity').value,
          state: document.getElementById('orgState').value,
          zip: document.getElementById('orgZip').value
        }
      };

      try {
        const res = await fetch(API + '/api/organizations', {
          method: 'POST', headers: authHeaders(), body: JSON.stringify(body)
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to create organization');
        }
        const data = await res.json();
        allOrgs.push(data);
        selectedOrg = data;
        await loadDashboard(data._id);
        toggleCreateForm();
        document.getElementById('createOrgForm').reset();
        showToast('success', 'Organization created successfully');
        render();
      } catch (err) {
        showToast('error', err.message);
      }
    });

    // ── Invite Member ──
    document.getElementById('inviteMemberForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!selectedOrg) return;

      const body = {
        email: document.getElementById('inviteEmail').value,
        role: document.getElementById('inviteRole').value
      };

      try {
        const res = await fetch(API + '/api/organizations/' + selectedOrg._id + '/invite', {
          method: 'POST', headers: authHeaders(), body: JSON.stringify(body)
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to send invitation');
        }
        document.getElementById('inviteEmail').value = '';
        toggleInviteForm();
        await loadDashboard(selectedOrg._id);
        showToast('success', 'Invitation sent');
        render();
      } catch (err) {
        showToast('error', err.message);
      }
    });

    // ── Remove Member ──
    async function removeMember(seatId) {
      if (!selectedOrg) return;
      if (!confirm('Remove this member from the organization?')) return;

      try {
        const res = await fetch(API + '/api/organizations/' + selectedOrg._id + '/members/' + seatId, {
          method: 'DELETE', headers: authHeaders()
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to remove member');
        }
        await loadDashboard(selectedOrg._id);
        showToast('success', 'Member removed');
        render();
      } catch (err) {
        showToast('error', err.message);
      }
    }
  </script>
<script src="/js/cr-icons.js"></script>
</body>
</html>

