  <script>
    const API = location.hostname === 'localhost' ? 'http://localhost:5000' : 'https://api.counselorready.com';
    const T = localStorage.getItem('token');
    if (!T) location.href = '/login.html';

    // ── Set user avatar from JWT ──
    try {
      const p = JSON.parse(atob(T.split('.')[1]));
      document.getElementById('userName').textContent = p.name || '';
      document.getElementById('userAvatar').textContent = (p.name || '--').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    } catch (e) {}

    // ── Escape HTML ──
    function esc(str) {
      if (!str) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // ── Init ──
    document.addEventListener('DOMContentLoaded', init);

    async function init() {
      try {
        const res = await fetch(`${API}/api/recommendations`, {
          headers: { 'Authorization': `Bearer ${T}` }
        });

        if (!res.ok) throw new Error('Failed to load recommendations');
        const data = await res.json();

        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');

        renderSummary(data.summary);
        renderExpirations(data.summary?.upcomingExpirations);
        renderCourses(data.recommendations);
      } catch (err) {
        console.error('Failed to load recommendations:', err);
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');
        document.getElementById('emptyState').classList.remove('hidden');
      }
    }

    // ── Summary Cards ──
    function renderSummary(summary) {
      if (!summary) return;
      const container = document.getElementById('summaryCards');
      container.innerHTML = `
        <div class="rounded-xl border border-burgundy-300 p-5" style="background: linear-gradient(135deg, #fae8eb, #f5d0d6);">
          <div class="text-3xl font-bold text-burgundy-800">${esc(String(summary.totalHoursNeeded ?? 0))}</div>
          <div class="text-sm text-burgundy-700 font-medium">CE Hours Needed</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="text-3xl font-bold text-gray-900">${esc(String(summary.coursesCompleted ?? 0))}</div>
          <div class="text-sm text-gray-500">Courses Completed</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="text-3xl font-bold text-gray-900">${esc(String(summary.coursesAvailable ?? 0))}</div>
          <div class="text-sm text-gray-500">Courses Available</div>
        </div>
      `;
    }

    // ── Upcoming Expirations ──
    function renderExpirations(expirations) {
      if (!expirations || expirations.length === 0) return;
      const container = document.getElementById('expirations');
      container.classList.remove('hidden');
      container.innerHTML = `
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5">
          <h2 class="font-display font-semibold text-amber-800 text-lg mb-3">
            <i class="fas fa-exclamation-triangle mr-2"></i>Upcoming Credential Expirations
          </h2>
          <div class="space-y-2">
            ${expirations.map(exp => `
              <div class="flex justify-between items-center">
                <span class="text-sm text-amber-900 font-medium">${esc(exp.credential)}</span>
                <div class="text-right">
                  <div class="text-sm text-amber-700">Expires ${new Date(exp.expirationDate).toLocaleDateString()}</div>
                  <div class="text-xs text-amber-600">${esc(String(exp.hoursNeeded))} hours needed</div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    // ── Recommended Courses ──
    function renderCourses(recommendations) {
      const container = document.getElementById('courseList');
      const emptyState = document.getElementById('emptyState');

      if (!recommendations || recommendations.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      }

      container.innerHTML = recommendations.map(course => {
        // Relevance reasons
        const reasonBadges = (course.reasons || []).map(reason =>
          `<span class="text-xs px-2 py-1 bg-burgundy-100 text-burgundy-800 rounded-full">${esc(reason)}</span>`
        ).join('');

        // Approval badges
        const approvalBadges = (course.approvals || []).map(approval =>
          `<span class="text-xs px-2 py-0.5 bg-hunter-100 text-hunter-700 rounded-full font-medium">
            <i class="fas fa-check-circle mr-1"></i>${esc(approval)}
          </span>`
        ).join('');

        // Meta info items
        const metaItems = [];
        if (course.ceHours) metaItems.push(`<span><i class="fas fa-clock mr-1"></i>${esc(String(course.ceHours))} CE Hours</span>`);
        if (course.category) metaItems.push(`<span class="capitalize">${esc(course.category)}</span>`);
        if (course.accessTier) metaItems.push(`<span class="capitalize">${esc(course.accessTier)}</span>`);

        return `
          <div class="bg-white rounded-xl border border-gray-200 p-5 hover:border-burgundy-400 transition cursor-pointer"
               onclick="window.location.href='/course-details.html?slug=${encodeURIComponent(course.slug || '')}'">
            <div class="flex justify-between items-start">
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-gray-900 mb-1">${esc(course.title)}</h3>
                ${metaItems.length ? `<div class="flex items-center gap-3 text-sm text-gray-500 mb-2">${metaItems.join('')}</div>` : ''}
                ${course.summary ? `<p class="text-sm text-gray-600 mb-2">${esc(course.summary)}</p>` : ''}
                ${course.description && !course.summary ? `<p class="text-sm text-gray-600 mb-2">${esc(course.description.substring(0, 160))}${course.description.length > 160 ? '...' : ''}</p>` : ''}
                ${reasonBadges ? `<div class="flex flex-wrap gap-2 mb-2">${reasonBadges}</div>` : ''}
                ${approvalBadges ? `<div class="flex flex-wrap gap-2">${approvalBadges}</div>` : ''}
              </div>
              <div class="ml-4 flex flex-col items-end gap-2">
                ${course.relevanceScore != null ? `
                  <div class="bg-burgundy-200 text-burgundy-800 rounded-full w-10 h-10 flex items-center justify-center font-bold text-sm" title="Relevance score">
                    ${esc(String(course.relevanceScore))}
                  </div>
                ` : ''}
                <a href="/course-details.html?slug=${encodeURIComponent(course.slug || '')}"
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-burgundy-700 text-white text-xs font-medium rounded-lg hover:bg-burgundy-800 transition-colors"
                   onclick="event.stopPropagation()">
                  Start Course <i class="fas fa-arrow-right text-xs"></i>
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }
  </script>
<script src="/js/cr-icons.js"></script>
</body>
</html>

