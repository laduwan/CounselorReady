<script>
  // ── Edit Course Modal Logic ──
  function togglePremiumStyle() {
    const cb = document.getElementById('editPremium');
    const wrap = document.getElementById('premiumToggle');
    const badge = document.getElementById('premiumBadge');
    if (cb.checked) {
      wrap.style.borderColor = '#D4A855';
      wrap.style.background = '#FFFDF5';
      badge.style.display = 'inline-block';
    } else {
      wrap.style.borderColor = '#E5E2DC';
      wrap.style.background = 'transparent';
      badge.style.display = 'none';
    }
  }

  function openEditModal(courseId, source) {
    const modal = document.getElementById('editModal');
    const isNew = !courseId;

    document.getElementById('editModalTitle').textContent = isNew ? 'New Course' : 'Edit Course';
    document.getElementById('editSaveBtn').textContent = isNew ? 'Create Course' : 'Save Changes';
    document.getElementById('editCourseId').value = courseId || '';
    document.getElementById('editCourseSource').value = source || 'interactivecourses';

    if (isNew) {
      // Clear all fields for new course
      document.getElementById('editTitle').value = '';
      document.getElementById('editSubtitle').value = '';
      document.getElementById('editDescription').value = '';
      document.getElementById('editSlug').value = '';
      document.getElementById('editCourseCode').value = '';
      document.getElementById('editCEHours').value = '3';
      document.getElementById('editCategory').value = 'core';
      document.getElementById('editPrice').value = '';
      document.getElementById('editAccessTier').value = 'professional';
      document.getElementById('editPremium').checked = false;
      togglePremiumStyle();
      document.getElementById('editStatus').value = 'draft';
      document.getElementById('editPresenter').value = 'Kejuiana Johnson, MA, LPC, NCC, CPCS, BC-TMH';
      document.getElementById('editObjectives').value = '';
      document.getElementById('editPreviewLink').style.display = 'none';
      modal.style.display = 'flex';
      return;
    }

    // Populate from cached allCourses data
    const c = allCourses.find(x => x._id === courseId);
    if (!c) {
      showToast('Course not found in cache', '#dc2626');
      return;
    }

    document.getElementById('editTitle').value = c.title || '';
    document.getElementById('editSubtitle').value = c.subtitle || '';
    document.getElementById('editDescription').value = c.description || '';
    document.getElementById('editSlug').value = c.slug || '';
    document.getElementById('editCourseCode').value = c.courseCode || '';
    document.getElementById('editCEHours').value = c.ceHours || c.ceuHours || 0;
    document.getElementById('editPrice').value = c.price || '';
    const tierVal = c.accessTier || c.pricingTier || 'professional';
    const isPrem = c.isPremium || tierVal === 'premium';
    document.getElementById('editAccessTier').value = isPrem ? 'professional' : tierVal;
    document.getElementById('editPremium').checked = isPrem;
    togglePremiumStyle();
    document.getElementById('editStatus').value = c.status || 'draft';
    document.getElementById('editPresenter').value = c.presenter?.name || 'Kejuiana Johnson, MA, LPC, NCC, CPCS, BC-TMH';

    // Category — try multiple fields
    const cat = (c.ceuCategories && c.ceuCategories[0]?.category) || c.category || 'core';
    document.getElementById('editCategory').value = cat;

    // Learning objectives
    const objs = c.learningObjectives || [];
    document.getElementById('editObjectives').value = objs.join('\n');

    // Preview links
    const previewDiv = document.getElementById('editPreviewLink');
    if (c.slug) {
      previewDiv.style.display = 'block';
      document.getElementById('editPreviewAnchor').href = `/interactive-course.html?slug=${c.slug}&preview=true`;
      document.getElementById('editPreviewAdmin').href = `/interactive-course.html?id=${c._id}&preview=true`;
    } else {
      previewDiv.style.display = 'none';
    }

    modal.style.display = 'flex';
  }

  function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
  }

  async function saveEditModal() {
    const courseId = document.getElementById('editCourseId').value;
    const source = document.getElementById('editCourseSource').value;
    const isNew = !courseId;
    const btn = document.getElementById('editSaveBtn');
    btn.textContent = 'Saving...';
    btn.disabled = true;

    const title = document.getElementById('editTitle').value.trim();
    if (!title) {
      showToast('Title is required', '#dc2626');
      btn.textContent = isNew ? 'Create Course' : 'Save Changes';
      btn.disabled = false;
      return;
    }

    let slug = document.getElementById('editSlug').value.trim();
    if (!slug) {
      slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }

    const objectivesRaw = document.getElementById('editObjectives').value.trim();
    const learningObjectives = objectivesRaw ? objectivesRaw.split('\n').map(s => s.trim()).filter(Boolean) : [];
    const ceVal = parseFloat(document.getElementById('editCEHours').value) || 0;
    const priceVal = parseFloat(document.getElementById('editPrice').value) || 0;
    const isPremium = document.getElementById('editPremium').checked;
    const tierVal = isPremium ? 'premium' : document.getElementById('editAccessTier').value;

    const payload = {
      title,
      subtitle: document.getElementById('editSubtitle').value.trim(),
      description: document.getElementById('editDescription').value.trim(),
      slug,
      courseCode: document.getElementById('editCourseCode').value.trim(),
      ceHours: ceVal,
      ceuHours: ceVal,
      category: document.getElementById('editCategory').value,
      price: priceVal,
      isPremium,
      accessTier: tierVal,
      pricingTier: tierVal,
      status: document.getElementById('editStatus').value,
      learningObjectives,
      objectives: learningObjectives
    };

    const hdrs = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };

    try {
      let r, lastErr;

      if (isNew) {
        // ── CREATE: try multiple endpoints ──
        payload.sections = [];
        payload.presenter = {
          name: document.getElementById('editPresenter').value.trim(),
          credentials: 'MA, LPC, NCC, CPCS, BC-TMH'
        };
        payload.provider = {
          name: 'GA Integrated Therapeutic Perspectives LLC',
          shortName: 'GAITP LLC',
          acepNumber: '7760',
          approvalBody: 'NBCC'
        };

        const createEndpoints = [
          `${API_URL}/api/admin/courses`,
          `${API_URL}/api/interactive-courses`
        ];

        for (const url of createEndpoints) {
          console.log('[EditModal] Trying POST', url);
          try {
            r = await fetch(url, { method: 'POST', headers: hdrs, body: JSON.stringify(payload) });
            const body = await r.clone().json().catch(() => ({}));
            console.log('[EditModal] Response', r.status, body);
            if (r.ok) break;
            lastErr = body.error || body.message || `${r.status}`;
          } catch(e) { console.warn('[EditModal]', url, e); lastErr = e.message; }
        }
      } else {
        // ── UPDATE: try metadata PATCH first (proven working from Meta modal) ──
        const updateEndpoints = [
          { url: `${API_URL}/api/interactive-courses/${courseId}/metadata`, method: 'PATCH' },
          { url: `${API_URL}/api/interactive-courses/${courseId}`, method: 'PUT' },
          { url: `${API_URL}/api/admin/courses/${courseId}`, method: 'PUT' }
        ];

        for (const ep of updateEndpoints) {
          console.log('[EditModal] Trying', ep.method, ep.url);
          try {
            r = await fetch(ep.url, { method: ep.method, headers: hdrs, body: JSON.stringify(payload) });
            const body = await r.clone().json().catch(() => ({}));
            console.log('[EditModal] Response', r.status, body);
            if (r.ok) break;
            lastErr = body.error || body.message || `${r.status}`;
          } catch(e) { console.warn('[EditModal]', ep.url, e); lastErr = e.message; }
        }
      }

      if (!r || !r.ok) {
        throw new Error(lastErr || 'All save attempts failed — check console for details');
      }

      showToast(isNew ? '✓ Course created' : '✓ Course updated', '#4A7C59');
      closeEditModal();
      loadCourses();
    } catch(e) {
      console.error('[EditModal] Final error:', e);
      showToast('Error: ' + e.message, '#dc2626');
    } finally {
      btn.textContent = isNew ? 'Create Course' : 'Save Changes';
      btn.disabled = false;
    }
  }

  // Close on backdrop
  document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditModal();
  });
</script>

