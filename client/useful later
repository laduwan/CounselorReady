  <script>
    const API_URL = window.location.hostname === 'localhost' ? 'http://localhost:5000' : 'https://api.counselorready.com';
    const token = localStorage.getItem('token');
    if (!token) window.location.href = '/login.html';

    const WORDS_PER_CE_HOUR = 6000;
    let allCourses = [];
    let filtered = [];
    let page = 1;
    const PER_PAGE = 20;
    let pendingFn = null;

    // ── Health classification ──
    function wordCount(course) {
      // Use pre-computed wordCount field from DB
      if (course.wordCount && course.wordCount > 0) return course.wordCount;
      // Fallback: calculate from full course data if available
      let count = 0;
      const sections = course.sections || course.modules || [];
      sections.forEach(sec => {
        const blocks = sec.contentBlocks || sec.lessons || [];
        blocks.forEach(b => {
          const text = b.textContent || b.content || b.body || '';
          const plain = text.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
          if (plain) count += plain.split(' ').length;
        });
      });
      return count;
    }

    function healthStatus(course) {
      const ceHours = course.ceHours || course.ceuHours || 0;
      if (!ceHours) return 'needs';
      const words = wordCount(course);
      if (words === 0) return 'needs';
      const target = ceHours * WORDS_PER_CE_HOUR;
      const pct = Math.round((words / target) * 100);
      if (pct >= 90) return 'complete';
      if (pct >= 50) return 'nearly';
      return 'progress';
    }

    function healthInfo(status) {
      const map = {
        complete:  { label: '✅ Complete',     bg: 'bg-green-50',  border: 'border-green-200',  text: 'text-green-700',  bar: 'bg-green-500',  pct: '≥90%' },
        nearly:    { label: '🟡 Nearly There', bg: 'bg-yellow-50', border: 'border-yellow-200', text: 'text-yellow-700', bar: 'bg-yellow-400', pct: '50–89%' },
        progress:  { label: '🔨 In Progress',  bg: 'bg-blue-50',   border: 'border-blue-200',   text: 'text-blue-700',   bar: 'bg-blue-400',   pct: '<50%' },
        needs:     { label: '⚠️ Needs Attention', bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700', bar: 'bg-amber-400',  pct: '0%' },
      };
      return map[status] || map.needs;
    }

    async function init() {
      try {
        const r = await fetch(`${API_URL}/api/auth/me`, { headers: { Authorization: `Bearer ${token}` } });
        if (r.ok) {
          const d = await r.json();
          const u = d.user || d;
          document.getElementById('adminEmail').textContent = u.email || 'Admin';
          if (!u.isAdmin && u.role !== 'admin') window.location.href = '/dashboard.html';
        }
      } catch(e) {}
      loadCourses();
    }

    async function loadCourses() {
      show('loadingState'); hide('mainContent'); hide('errorState');
      try {
        let courses = [];

        // Admin courses
        try {
          const ctrl1 = new AbortController();
          setTimeout(() => ctrl1.abort(), 10000);
          const r = await fetch(`${API_URL}/api/admin/courses`, {
            headers: { Authorization: `Bearer ${token}` },
            signal: ctrl1.signal
          });
          if (r.ok) {
            const d = await r.json();
            courses = (d.data || d || []).map(c => ({ ...c, _source: 'admincourses' }));
          }
        } catch(e) { console.warn('Fetch failed:', e.message); }

        // Interactive courses (all courses live here now)
        try {
          let p = 1;
          while (true) {
            const ctrl2 = new AbortController();
            setTimeout(() => ctrl2.abort(), 10000);
            const r = await fetch(`${API_URL}/api/interactive-courses?page=${p}&limit=200&status=all`, {
              headers: { Authorization: `Bearer ${token}` },
              signal: ctrl2.signal
            });
            if (!r.ok) break;
            const d = await r.json();
            const batch = (d.data || []).map(c => ({ ...c, _source: 'interactivecourses' }));
            // Prefer interactivecourses version (deduplicate by slug)
            batch.forEach(ic => {
              const idx = courses.findIndex(c => c.slug === ic.slug);
              if (idx >= 0) courses[idx] = ic;
              else courses.push(ic);
            });
            if (p >= (d.pagination?.pages || 1) || batch.length === 0) break;
            p++;
          }
        } catch(e) { console.warn('Fetch failed:', e.message); }

        // Annotate with health
        allCourses = courses.map(c => ({ ...c, _health: healthStatus(c), _words: wordCount(c) }));

        updateHealthDashboard();
        renderCourses();
        hide('loadingState');
        show('mainContent');
      } catch(e) {
        hide('loadingState');
        show('errorState');
        document.getElementById('errorMsg').textContent = 'Failed to load: ' + e.message;
      }
    }

    function updateHealthDashboard() {
      const total = allCourses.length;
      const counts = { complete: 0, nearly: 0, progress: 0, needs: 0 };
      let totalWords = 0, totalHours = 0;
      allCourses.forEach(c => { counts[c._health]++; totalWords += c._words; totalHours += (c.ceHours || c.ceuHours || 0); });

      document.getElementById('countComplete').textContent = counts.complete;
      document.getElementById('countNearly').textContent = counts.nearly;
      document.getElementById('countProgress').textContent = counts.progress;
      document.getElementById('countNeeds').textContent = counts.needs;

      const compliantPct = total > 0 ? Math.round((counts.complete / total) * 100) : 0;
      document.getElementById('healthPct').textContent = compliantPct + '%';
      document.getElementById('healthSubtitle').textContent =
        `${totalWords.toLocaleString()} total words across ${total} courses · ${totalHours} CE hours`;

      const pct = n => total > 0 ? Math.round((n / total) * 100) : 0;
      document.getElementById('hbComplete').style.width = pct(counts.complete) + '%';
      document.getElementById('hbNearly').style.width = pct(counts.nearly) + '%';
      document.getElementById('hbProgress').style.width = pct(counts.progress) + '%';
      document.getElementById('hbNeeds').style.width = pct(counts.needs) + '%';

      document.getElementById('healthLegend').innerHTML = [
        ['bg-green-500', `Complete ${counts.complete}`],
        ['bg-yellow-400', `Nearly There ${counts.nearly}`],
        ['bg-blue-400', `In Progress ${counts.progress}`],
        ['bg-gray-300', `Needs Attention ${counts.needs}`],
      ].map(([bg, label]) => `<span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full ${bg} inline-block"></span>${label}</span>`).join('');
    }

    function setFilter(health) {
      document.getElementById('contentFilter').value = health;
      renderCourses();
    }

    function renderCourses() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const st = document.getElementById('statusFilter').value;
      const ct = document.getElementById('contentFilter').value;

      filtered = allCourses.filter(c => {
        const mQ = !q || (c.title || '').toLowerCase().includes(q) || (c.slug || '').includes(q);
        const mS = !st || c.status === st;
        const mC = !ct || c._health === ct;
        return mQ && mS && mC;
      });

      // Sort: published first, then by health status priority, then title
      const hOrder = { complete: 0, nearly: 1, progress: 2, needs: 3 };
      filtered.sort((a, b) => {
        if (a.status === 'published' && b.status !== 'published') return -1;
        if (a.status !== 'published' && b.status === 'published') return 1;
        return (hOrder[a._health] || 0) - (hOrder[b._health] || 0) || (a.title || '').localeCompare(b.title || '');
      });

      page = 1;
      renderPage();
    }

    function renderPage() {
      const start = (page - 1) * PER_PAGE;
      const items = filtered.slice(start, start + PER_PAGE);
      const total = filtered.length;

      document.getElementById('courseCount').textContent = `${total} courses`;
      document.getElementById('pageInfo').textContent = total > PER_PAGE
        ? `Showing ${start + 1}–${Math.min(start + PER_PAGE, total)} of ${total}` : '';
      document.getElementById('prevBtn').disabled = page <= 1;
      document.getElementById('nextBtn').disabled = page >= Math.ceil(total / PER_PAGE);
      document.getElementById('paginationRow').style.display = total > PER_PAGE ? 'flex' : 'none';

      document.getElementById('courseCards').innerHTML = items.length === 0
        ? '<div class="text-center py-12 text-forest-500 bg-white rounded-xl border border-burgundy-100">No courses found</div>'
        : items.map(courseCard).join('');
    }

    function courseCard(c) {
      const pub = c.status === 'published';
      const h = healthInfo(c._health);
      const ceHours = c.ceHours || c.ceuHours || 0;
      const target = ceHours * WORDS_PER_CE_HOUR;
      const wordPct = target > 0 ? Math.min(100, Math.round((c._words / target) * 100)) : 0;
      const sections = c.sectionCount || c.moduleCount || (c.sections || c.modules || []).length;
      const price = c.price ? `$${c.price}` : null;
      const tier = c.accessTier || c.pricingTier || null;
      const isPrem = c.isPremium || tier === 'premium';
      const displayTier = isPrem ? null : tier;
      const tierLabel = ({ free: 'Free', basic: 'Basic', professional: 'Professional', vip: 'VIP' }[displayTier] || displayTier);
      const courseCode = c.courseCode || '';

      const barColor = { complete: 'bg-green-500', nearly: 'bg-yellow-400', progress: 'bg-blue-400', needs: 'bg-gray-300' }[c._health];
      const barTextColor = { complete: 'text-green-600', nearly: 'text-yellow-600', progress: 'text-blue-500', needs: 'text-gray-400' }[c._health];
      const src = c._source || 'interactivecourses';

      return `
        <div data-slug="${c.slug}" class="bg-white rounded-xl border border-burgundy-100 shadow-sm hover:shadow-md transition-all p-5">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                ${courseCode ? `<span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-navy-800 text-white whitespace-nowrap">${esc(courseCode)}</span>` : ''}
                <h3 class="font-display text-lg font-semibold text-burgundy-900">${esc(c.title || 'Untitled')}</h3>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border ${h.bg} ${h.text} ${h.border} whitespace-nowrap">
                  ${h.label}
                </span>
                <span class="px-2 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${pub ? 'bg-green-50 text-green-700 border-green-200' : 'bg-yellow-50 text-yellow-700 border-yellow-200'}">
                  ${pub ? 'published' : 'draft'}
                </span>
                ${isPrem ? `<span class="px-2 py-0.5 rounded-full text-xs font-bold border border-gold-400 bg-gold-50 text-gold-700 whitespace-nowrap">PREMIUM</span>` : ''}
                ${(displayTier && tierLabel) ? `<span class="px-2 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-600 border border-purple-200 whitespace-nowrap">${tierLabel}</span>` : ''}
              </div>
            </div>
            <div class="flex gap-1.5 shrink-0">
              <button onclick="togglePublish('${c._id}','${c.status}','${esc(c.title)}','${src}')"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-sm transition-colors ${pub ? 'bg-yellow-50 hover:bg-yellow-100 text-yellow-700' : 'bg-green-50 hover:bg-green-100 text-green-700'}"
                title="${pub ? 'Unpublish' : 'Publish'}">
                ${pub ? '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>' : '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>'}
              </button>
              <a href="/interactive-course.html?id=${c._id}&preview=true"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-sm bg-purple-50 hover:bg-purple-100 text-purple-700 transition-colors" title="Preview in Viewer"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg></a>
              <button onclick="duplicateCourse('${c._id}','${esc(c.title)}')"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-sm bg-gold-50 hover:bg-gold-100 text-gold-700 transition-colors" title="Duplicate"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg></button>
              <button onclick="openMetaModal('${c._id}','${esc(c.title)}','${src}',this)"
                class="h-8 px-3 rounded-lg text-xs font-medium bg-gold-50 hover:bg-gold-100 text-gold-700 transition-colors flex items-center" title="Delivery Format & Content Areas">Meta</button>
              <button onclick="openEditModal('${c._id}','${src}')"
                class="h-8 px-3 rounded-lg text-xs font-medium bg-forest-50 hover:bg-forest-100 text-forest-700 transition-colors flex items-center">Edit</button>
              <button onclick="deleteCourse('${c._id}','${esc(c.title)}','${src}')"
                class="h-8 px-3 rounded-lg text-xs font-medium bg-burgundy-50 hover:bg-burgundy-100 text-burgundy-700 transition-colors">Delete</button>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm flex-wrap">
            <span class="text-forest-600"><strong class="text-forest-800">${ceHours}</strong> CE hrs</span>
            <span class="text-forest-300">·</span>
            <span class="text-forest-600"><strong class="text-forest-800">${sections}</strong> modules</span>
            <span class="text-forest-300">·</span>
            <span class="text-forest-600"><strong class="text-forest-800">${c._words.toLocaleString()}</strong> words</span>
            ${target > 0 ? `
            <span class="text-forest-300">·</span>
            <span class="inline-flex items-center gap-2">
              <span class="w-24 bg-gray-100 rounded-full h-2 inline-block overflow-hidden">
                <span class="block h-2 rounded-full ${barColor} transition-all" style="width:${wordPct}%"></span>
              </span>
              <span class="text-xs font-medium ${barTextColor}">${wordPct}%</span>
            </span>` : ''}
            ${price ? `<span class="text-forest-300">·</span><span class="font-medium text-green-700">${price}</span>` : ''}
            ${c.enrollmentCount !== undefined ? `<span class="text-forest-300">·</span><span class="text-forest-500 text-xs">${c.enrollmentCount} enrolled</span>` : ''}
          </div>
        </div>
      `;
    }

    function changePage(d) { page += d; renderPage(); window.scrollTo(0, 0); }

    // ── Publish ──
    function togglePublish(id, status, title, src) {
      const pub = status !== 'published';
      confirm2(pub ? 'Publish Course' : 'Unpublish Course',
        pub ? `"${title}" will be visible to all users.` : `"${title}" will be hidden from users.`,
        async () => {
          try {
            let r;
            if (src === 'courses') {
              r = await fetch(`${API_URL}/api/admin/courses/${id}/publish`, {
                method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ publish: pub })
              });
            } else {
              r = await fetch(`${API_URL}/api/interactive-courses/${id}`, {
                method: 'PUT', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: pub ? 'published' : 'draft' })
              });
            }
            if (!r.ok) throw new Error('Update failed');
            showToast(pub ? '✓ Published' : '✓ Unpublished', pub ? '#4A7C59' : '#b8893f');
            loadCourses();
          } catch(e) { showToast('Error: ' + e.message, '#dc2626'); }
        });
    }

    async function bulkPublish(pub) {
      const targets = filtered.filter(c => pub ? c.status !== 'published' : c.status === 'published');
      if (!targets.length) { showToast('No courses to update', '#284157'); return; }
      confirm2(`${pub ? 'Publish' : 'Unpublish'} ${targets.length} Courses`,
        `This will ${pub ? 'publish' : 'unpublish'} ${targets.length} courses currently shown.`,
        async () => {
          let done = 0;
          for (const c of targets) {
            try {
              if (c._source === 'courses') {
                await fetch(`${API_URL}/api/admin/courses/${c._id}/publish`, {
                  method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                  body: JSON.stringify({ publish: pub })
                });
              } else {
                await fetch(`${API_URL}/api/interactive-courses/${c._id}`, {
                  method: 'PUT', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
                  body: JSON.stringify({ status: pub ? 'published' : 'draft' })
                });
              }
              done++;
            } catch(e) {}
          }
          showToast(`✓ ${done} courses updated`, '#4A7C59');
          loadCourses();
        });
    }

    // ── Delete ──
    function deleteCourse(id, title, src) {
      confirm2('Delete Course', `Permanently delete "${title}"? This cannot be undone.`, async () => {
        try {
          const url = src === 'courses'
            ? `${API_URL}/api/admin/courses/${id}`
            : `${API_URL}/api/interactive-courses/${id}`;
          const r = await fetch(url, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
          if (!r.ok) throw new Error('Delete failed');
          showToast('✓ Course deleted', '#6b1d34');
          loadCourses();
        } catch(e) { showToast('Error: ' + e.message, '#dc2626'); }
      });
    }

    // ── Duplicate ──
    async function duplicateCourse(id, title) {
      try {
        showToast('Duplicating...', '#284157');
        const r = await fetch(`${API_URL}/api/interactive-courses/${id}/duplicate`, {
          method: 'POST', headers: { Authorization: `Bearer ${token}` }
        });
        if (!r.ok) throw new Error('Not supported by API');
        showToast('✓ Duplicated', '#4A7C59');
        loadCourses();
      } catch(e) { showToast('Duplicate: ' + e.message, '#dc2626'); }
    }

    // ── AI Generate ──
    function openAIModal() { document.getElementById('aiModal').style.display = 'flex'; }
    function closeAIModal() { document.getElementById('aiModal').style.display = 'none'; }

    async function runAI() {
      const topic = document.getElementById('aiTopic').value.trim();
      if (!topic) { showToast('Please enter a topic', '#dc2626'); return; }
      const btn = document.getElementById('aiBtn');
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
      btn.disabled = true;
      try {
        const r = await fetch(`${API_URL}/api/ai-course-generator/generate`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            topic,
            ceHours: parseInt(document.getElementById('aiHours').value),
            category: document.getElementById('aiCategory').value,
            notes: document.getElementById('aiNotes').value
          })
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || d.message || 'Failed');
        closeAIModal();
        showToast('✓ Generated! Opening editor...', '#4A7C59');
        const cid = d.data?._id || d.course?._id || d._id;
        setTimeout(() => { if (cid) openEditModal(cid, 'interactivecourses'); else loadCourses(); }, 1500);
      } catch(e) {
        showToast('Error: ' + e.message, '#dc2626');
      } finally {
        btn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Generate Course';
        btn.disabled = false;
      }
    }

    // ── Helpers ──
    function confirm2(title, msg, fn) {
      pendingFn = fn;
      document.getElementById('confirmTitle').textContent = title;
      document.getElementById('confirmMsg').textContent = msg;
      document.getElementById('confirmModal').style.display = 'flex';
    }
    function closeConfirm() { document.getElementById('confirmModal').style.display = 'none'; pendingFn = null; }
    function doConfirm() { closeConfirm(); if (pendingFn) pendingFn(); }

    function showToast(msg, bg = '#6b1d34') {
      const el = document.getElementById('toastMsg');
      el.textContent = msg;
      el.style.background = bg;
      document.getElementById('toast').classList.remove('hidden');
      clearTimeout(window._tt);
      window._tt = setTimeout(() => document.getElementById('toast').classList.add('hidden'), 3000);
    }

    function show(id) { document.getElementById(id).classList.remove('hidden'); }
    function hide(id) { document.getElementById(id).classList.add('hidden'); }
    function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

    init();
  </script>
