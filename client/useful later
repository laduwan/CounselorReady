function togglePanel(i){
  const d=document.getElementById('detail'+i);
  const c=document.getElementById('chev'+i);
  d.classList.toggle('open');c.classList.toggle('open');
}

function toggleForm(){
  editingId=null;
  document.getElementById('formTitle').textContent='Add Insurance Panel';
  document.getElementById('submitBtn').textContent='Add Panel';
  clearForm();
  document.getElementById('panelForm').classList.toggle('hidden');
}

function cancelForm(){document.getElementById('panelForm').classList.add('hidden');editingId=null;}

function clearForm(){
  ['fCompany','fCaqh','fContactName','fContactPhone','fContactEmail','fPortal','fNotes'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('fPanelType').value='in_network';
  document.getElementById('fStatus').value='not_started';
  document.getElementById('fAppDate').value='';
  document.getElementById('fFollowUp').value='';
}

function editPanel(id){
  const c=credentials.find(x=>x._id===id);if(!c)return;
  editingId=id;
  document.getElementById('formTitle').textContent='Edit Insurance Panel';
  document.getElementById('submitBtn').textContent='Update Panel';
  document.getElementById('fCompany').value=c.insuranceCompany||'';
  document.getElementById('fPanelType').value=c.panelType||'in_network';
  document.getElementById('fStatus').value=c.applicationStatus||'not_started';
  document.getElementById('fAppDate').value=c.applicationDate?c.applicationDate.split('T')[0]:'';
  document.getElementById('fCaqh').value=c.caqhId||'';
  document.getElementById('fContactName').value=c.contactName||'';
  document.getElementById('fContactPhone').value=c.contactPhone||'';
  document.getElementById('fContactEmail').value=c.contactEmail||'';
  document.getElementById('fPortal').value=c.portalUrl||'';
  document.getElementById('fFollowUp').value=c.nextFollowUpDate?c.nextFollowUpDate.split('T')[0]:'';
  document.getElementById('fNotes').value=c.notes||'';
  document.getElementById('panelForm').classList.remove('hidden');
  document.getElementById('panelForm').scrollIntoView({behavior:'smooth'});
}

async function handleSubmit(e){
  e.preventDefault();
  const body={
    insuranceCompany:document.getElementById('fCompany').value,
    panelType:document.getElementById('fPanelType').value,
    applicationStatus:document.getElementById('fStatus').value,
    applicationDate:document.getElementById('fAppDate').value||undefined,
    caqhId:document.getElementById('fCaqh').value,
    contactName:document.getElementById('fContactName').value,
    contactPhone:document.getElementById('fContactPhone').value,
    contactEmail:document.getElementById('fContactEmail').value,
    portalUrl:document.getElementById('fPortal').value,
    nextFollowUpDate:document.getElementById('fFollowUp').value||undefined,
    notes:document.getElementById('fNotes').value,
    documentsChecklist:editingId?undefined:DEFAULT_CHECKLIST
  };
  try{
    const url=editingId?`${API}/api/insurance-credentials/${editingId}`:`${API}/api/insurance-credentials`;
    const method=editingId?'PUT':'POST';
    const r=await fetch(url,{method,headers:{Authorization:`Bearer ${T}`,'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!r.ok){const d=await r.json();throw new Error(d.error||'Failed');}
    showToast(editingId?'Updated successfully':'Insurance panel added','success');
    cancelForm();
    const rr=await fetch(`${API}/api/insurance-credentials`,{headers:{Authorization:`Bearer ${T}`}});
    credentials=await rr.json();
    renderStatusCards();renderPanels();
  }catch(e){showToast(e.message,'error');}
}

async function toggleChecklist(id,idx){
  try{
    await fetch(`${API}/api/insurance-credentials/${id}/checklist/${idx}`,{method:'PATCH',headers:{Authorization:`Bearer ${T}`}});
    const c=credentials.find(x=>x._id===id);
    if(c&&c.documentsChecklist&&c.documentsChecklist[idx])c.documentsChecklist[idx].uploaded=!c.documentsChecklist[idx].uploaded;
    renderPanels();
  }catch(e){showToast('Failed to update checklist','error');}
}

async function deletePanel(id){
  if(!confirm('Delete this insurance panel?'))return;
  try{
    await fetch(`${API}/api/insurance-credentials/${id}`,{method:'DELETE',headers:{Authorization:`Bearer ${T}`}});
    credentials=credentials.filter(c=>c._id!==id);
    renderStatusCards();renderPanels();
    showToast('Panel deleted','success');
  }catch(e){showToast('Failed to delete','error');}
}

function showToast(msg,type){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.style.background=type==='error'?'#fee2e2':'#d1fae5';
  t.style.color=type==='error'?'#991b1b':'#065f46';
  t.classList.remove('hidden');
  setTimeout(()=>t.classList.add('hidden'),3000);
}

document.addEventListener('DOMContentLoaded',init);
</script>
