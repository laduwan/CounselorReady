  <script>
    const API = location.hostname === 'localhost' ? 'http://localhost:5000' : 'https://api.counselorready.com';
    const T = localStorage.getItem('token');
    if (!T) location.href = '/login.html';

    let licenses = [];
    let selected = null;
    let compliance = null;

    // ── User avatar from JWT ──
    try {
      const p = JSON.parse(atob(T.split('.')[1]));
      document.getElementById('userName').textContent = p.name || '';
      document.getElementById('userAvatar').textContent = (p.name || '--').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    } catch (e) {}

    // ── Init ──
    document.addEventListener('DOMContentLoaded', init);

    async function init() {
      await fetchLicenses();
    }

    // ── Fetch Licenses ──
    async function fetchLicenses() {
      try {
        const res = await fetch(`${API}/api/group-licenses/my`, {
          headers: { 'Authorization': `Bearer ${T}` }
        });
        if (!res.ok) throw new Error('Failed to load licenses');
        const data = await res.json();
        licenses = Array.isArray(data) ? data : (data.data || []);

        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');

        if (licenses.length === 0) {
          document.getElementById('emptyState').classList.remove('hidden');
          document.getElementById('licensesLayout').classList.add('hidden');
        } else {
          document.getElementById('emptyState').classList.add('hidden');
          document.getElementById('licensesLayout').classList.remove('hidden');
          renderSelector();
          selectLicense(licenses[0]);
        }
      } catch (err) {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');
        document.getElementById('emptyState').classList.remove('hidden');
        showError(err.message || 'Failed to load licenses');
      }
    }

    // ── Fetch Compliance ──
    async function fetchCompliance(id) {
      try {
        const res = await fetch(`${API}/api/group-licenses/${id}/compliance`, {
          headers: { 'Authorization': `Bearer ${T}` }
        });
        if (!res.ok) { compliance = null; return; }
        compliance = await res.json();
      } catch {
        compliance = null;
      }
    }

    // ── Select a License ──
    async function selectLicense(lic) {
      selected = lic;
      renderSelector();
      await fetchCompliance(lic._id);
      renderDetail();
    }

    // ── Render License Selector ──
    function renderSelector() {
      const container = document.getElementById('licenseSelector');
      container.innerHTML = licenses.map((lic, i) => {
        const isActive = selected && selected._id === lic._id;
        const planColors = lic.plan === 'enterprise' ? 'bg-purple-100 text-purple-700'
          : lic.plan === 'academic' ? 'bg-green-100 text-green-700'
          : 'bg-blue-100 text-blue-700';
        return `
        <button onclick="selectLicense(licenses[${i}])" class="w-full text-left p-4 rounded-xl border transition ${isActive ? 'border-burgundy-600 bg-burgundy-50' : 'border-gray-200 bg-white hover:border-gray-300'}">
          <div class="font-semibold text-gray-900">${esc(lic.organizationName)}</div>
          <div class="text-sm text-gray-500 mt-1">${lic.usedSeats || 0}/${lic.totalSeats} seats used</div>
          <span class="mt-2 inline-block text-xs px-2 py-0.5 rounded-full ${planColors}">${esc(lic.plan)}</span>
        </button>`;
      }).join('');
    }

    // ── Render Detail Panel ──
    function renderDetail() {
      if (!selected) return;
      const panel = document.getElementById('detailPanel');

      const usedSeats = selected.usedSeats || 0;
      const totalSeats = selected.totalSeats || 0;
      const availableSeats = selected.availableSeats != null ? selected.availableSeats : (totalSeats - usedSeats);
      const complianceRate = compliance && compliance.complianceRate != null ? Math.round(compliance.complianceRate) : '--';

      // Seat assignments table
      const seats = (selected.seats || []).filter(s => s.status !== 'revoked');
      let seatsHTML = '';
      if (seats.length > 0) {
        seatsHTML = `
        <h3 class="font-display text-lg font-semibold text-burgundy-900 mb-3">Members</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-2 px-3 text-xs font-bold text-gray-500 uppercase">Name</th>
                <th class="text-left py-2 px-3 text-xs font-bold text-gray-500 uppercase">Email</th>
                <th class="text-left py-2 px-3 text-xs font-bold text-gray-500 uppercase">Status</th>
                <th class="text-left py-2 px-3 text-xs font-bold text-gray-500 uppercase">Assigned</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              ${seats.map(seat => {
                const name = seat.userId?.profile?.firstName
                  ? (seat.userId.profile.firstName + ' ' + (seat.userId.profile.lastName || '')).trim()
                  : (seat.name || seat.email || '--');
                const statusColors = seat.status === 'active' ? 'bg-green-100 text-green-700'
                  : seat.status === 'suspended' ? 'bg-red-100 text-red-700'
                  : 'bg-yellow-100 text-yellow-700';
                const assignedDate = seat.assignedAt ? new Date(seat.assignedAt).toLocaleDateString() : '--';
                return `<tr class="hover:bg-gray-50">
                  <td class="py-2.5 px-3 font-medium text-gray-900">${esc(name)}</td>
                  <td class="py-2.5 px-3 text-gray-500">${esc(seat.email || '--')}</td>
                  <td class="py-2.5 px-3"><span class="text-xs px-2 py-0.5 rounded-full ${statusColors}">${esc(seat.status)}</span></td>
                  <td class="py-2.5 px-3 text-gray-500">${assignedDate}</td>
                </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>`;
      } else {
        seatsHTML = '<p class="text-sm text-gray-400 italic">No members assigned yet. Invite members to get started.</p>';
      }

      // Compliance section
      let complianceHTML = '';
      if (compliance && compliance.memberProgress && compliance.memberProgress.length > 0) {
        complianceHTML = `
        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h3 class="font-display text-lg font-semibold text-burgundy-900 mb-4">Compliance Overview</h3>
          <div class="space-y-3">
            ${compliance.memberProgress.map(member => {
              const pct = Math.round(member.overallCompliance || 0);
              const barColor = pct === 100 ? 'bg-green-500' : 'bg-amber-500';
              const textColor = pct === 100 ? 'text-green-600' : 'text-amber-600';
              return `
              <div class="p-3 bg-stone-50 rounded-lg">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-sm font-medium text-gray-900">${esc(member.email || member.name || '--')}</span>
                  <span class="text-xs font-medium ${textColor}">${pct}% complete</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="h-2 rounded-full transition-all ${barColor}" style="width:${pct}%"></div>
                </div>
              </div>`;
            }).join('')}
          </div>
        </div>`;
      }

      panel.innerHTML = `
      <!-- Overview Card -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex justify-between items-start mb-4">
          <h2 class="font-display text-xl font-semibold text-burgundy-900">${esc(selected.organizationName)}</h2>
          <button onclick="showInvite()" class="text-sm px-3 py-1.5 bg-burgundy-100 text-burgundy-800 rounded-lg hover:bg-burgundy-200 transition font-medium">
            <i class="fas fa-user-plus mr-1"></i> Invite Members
          </button>
        </div>

        <!-- Stat Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="bg-stone-50 rounded-lg p-4 text-center">
            <div class="text-2xl font-bold text-gray-700">${totalSeats}</div>
            <div class="text-xs text-gray-500 mt-1">Total Seats</div>
          </div>
          <div class="bg-stone-50 rounded-lg p-4 text-center">
            <div class="text-2xl font-bold text-burgundy-700">${usedSeats}</div>
            <div class="text-xs text-gray-500 mt-1">Seats Used</div>
          </div>
          <div class="bg-stone-50 rounded-lg p-4 text-center">
            <div class="text-2xl font-bold text-green-600">${availableSeats}</div>
            <div class="text-xs text-gray-500 mt-1">Seats Available</div>
          </div>
          <div class="bg-stone-50 rounded-lg p-4 text-center">
            <div class="text-2xl font-bold text-hunter-500">${complianceRate}${complianceRate !== '--' ? '%' : ''}</div>
            <div class="text-xs text-gray-500 mt-1">Compliance Rate</div>
          </div>
        </div>

        <!-- Seat Assignments -->
        ${seatsHTML}
      </div>

      <!-- Compliance Breakdown -->
      ${complianceHTML}`;
    }

    // ── Create License ──
    document.getElementById('createForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      hideError();
      const body = {
        organizationName: document.getElementById('orgName').value.trim(),
        totalSeats: Number(document.getElementById('totalSeats').value),
        plan: document.getElementById('planSelect').value,
        billingCycle: document.getElementById('billingCycle').value,
        contactEmail: document.getElementById('contactEmail').value.trim()
      };
      try {
        const res = await fetch(`${API}/api/group-licenses`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${T}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to create license');
        }
        const data = await res.json();
        hideCreate();
        document.getElementById('createForm').reset();
        document.getElementById('totalSeats').value = '10';
        showSuccess('License created successfully');
        await fetchLicenses();
      } catch (err) {
        showError(err.message);
      }
    });

    // ── Invite Members ──
    document.getElementById('inviteForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!selected) return;
      hideError();
      const raw = document.getElementById('inviteEmails').value;
      const emails = raw.split(/[,\n]/).map(e => e.trim()).filter(Boolean);
      if (emails.length === 0) { showError('Please enter at least one email address'); return; }
      try {
        const res = await fetch(`${API}/api/group-licenses/${selected._id}/invite`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${T}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ emails })
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Failed to invite members');
        }
        hideInvite();
        document.getElementById('inviteEmails').value = '';
        showSuccess('Invitations sent successfully');
        await fetchLicenses();
      } catch (err) {
        showError(err.message);
      }
    });

    // ── Modal Helpers ──
    function showCreate() {
      document.getElementById('createModal').classList.remove('hidden');
    }
    function hideCreate() {
      document.getElementById('createModal').classList.add('hidden');
    }
    function showInvite() {
      if (selected) {
        const avail = selected.availableSeats != null ? selected.availableSeats : (selected.totalSeats - (selected.usedSeats || 0));
        document.getElementById('availableSeatsInfo').textContent = avail + ' seats available';
      }
      document.getElementById('inviteModal').classList.remove('hidden');
    }
    function hideInvite() {
      document.getElementById('inviteModal').classList.add('hidden');
    }

    // ── Message Helpers ──
    function showError(msg) {
      const el = document.getElementById('errorMsg');
      el.textContent = msg;
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 6000);
    }
    function hideError() {
      document.getElementById('errorMsg').classList.add('hidden');
    }
    function showSuccess(msg) {
      const el = document.getElementById('successMsg');
      el.textContent = msg;
      el.classList.remove('hidden');
      setTimeout(() => el.classList.add('hidden'), 4000);
    }

    // ── Escape HTML ──
    function esc(str) {
      if (!str) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }
  </script>
<script src="/js/cr-icons.js"></script>
</body>
</html>

