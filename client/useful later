<script>
  const API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:5000/api'
    : 'https://api.counselorready.com/api';

  const CLIENT_BASE = window.location.origin;

  let allCourses = [];
  let currentTab = 'all';
  let activeQRData = null;

  // ── URL helpers ──────────────────────────────────────────────
  const urls = {
    detail:  c => `${CLIENT_BASE}/course-details.html?slug=${c.slug}`,
    enroll:  c => `${CLIENT_BASE}/courses.html?enroll=${c.slug}`,
    viewer:  c => `${CLIENT_BASE}/interactive-course.html?slug=${c.slug}`,
  };

  function getActiveUrl(course) {
    if (currentTab === 'detail')  return urls.detail(course);
    if (currentTab === 'enroll')  return urls.enroll(course);
    if (currentTab === 'viewer')  return urls.viewer(course);
    return urls.enroll(course); // default
  }

  // ── Toast ─────────────────────────────────────────────────────
  function toast(msg) {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 2200);
  }

  // ── Copy single ───────────────────────────────────────────────
  async function copyLink(courseId) {
    const course = allCourses.find(c => c._id === courseId || c.id === courseId);
    if (!course) return;
    const url = getActiveUrl(course);
    await navigator.clipboard.writeText(url);
    const btn = document.getElementById(`copy-${courseId}`);
    if (btn) {
      btn.textContent = '✓ Copied';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.classList.remove('copied');
      }, 2000);
    }
    toast('Link copied!');
  }

  // ── Copy all visible ──────────────────────────────────────────
  async function copyAllLinks() {
    const visible = getFiltered();
    const lines = visible.map(c => `${c.title}\t${getActiveUrl(c)}`).join('\n');
    await navigator.clipboard.writeText(lines);
    toast(`${visible.length} links copied to clipboard`);
  }

  // ── Export CSV ────────────────────────────────────────────────
  function exportLinks() {
    const visible = getFiltered();
    const rows = [['Code','Title','CE Hours','Status','Detail URL','Enroll URL','Viewer URL']];
    visible.forEach(c => rows.push([
      c.courseCode || c.code || '',
      c.title,
      c.ceHours || '',
      c.isPublished ? 'Published' : 'Draft',
      urls.detail(c),
      urls.enroll(c),
      urls.viewer(c),
    ]));
    const csv = rows.map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
    a.download = `counselorready-course-links-${Date.now()}.csv`; a.click();
    toast('CSV downloaded');
  }

  // ── QR Modal ──────────────────────────────────────────────────
  function openQR(courseId) {
    const course = allCourses.find(c => (c._id || c.id) === courseId);
    if (!course) return;
    const url = urls.enroll(course);
    activeQRData = { url, title: course.title };

    document.getElementById('qr-title').textContent = course.title;
    document.getElementById('qr-url').textContent = url;
    const canvas = document.getElementById('qr-canvas');
    canvas.innerHTML = '';
    new QRCode(canvas, { text: url, width: 220, height: 220, correctLevel: QRCode.CorrectLevel.M });

    document.getElementById('qr-modal').classList.add('open');
  }

  function closeQR(e) {
    if (!e || e.target === document.getElementById('qr-modal') || !e.target) {
      document.getElementById('qr-modal').classList.remove('open');
    }
  }

  function downloadQR() {
    const img = document.querySelector('#qr-canvas img');
    if (!img) return;
    const a = document.createElement('a');
    a.href = img.src;
    a.download = `qr-${activeQRData.title.replace(/[^a-z0-9]/gi,'-').toLowerCase()}.png`;
    a.click();
  }

  // ── Tab ───────────────────────────────────────────────────────
  function setTab(tab, el) {
    currentTab = tab;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    renderCourses(getFiltered());
  }

  // ── Filter ────────────────────────────────────────────────────
  function getFiltered() {
    const q = document.getElementById('search-input').value.toLowerCase();
    const st = document.getElementById('status-filter').value;
    const ce = document.getElementById('ce-filter').value;
    return allCourses.filter(c => {
      const matchQ = !q || c.title.toLowerCase().includes(q) || (c.courseCode||'').toLowerCase().includes(q);
      const matchSt = !st || (st === 'published' ? (c.isPublished || c.status === 'published') : (!c.isPublished && c.status !== 'published'));
      const matchCe = !ce || String(c.ceHours) === ce;
      return matchQ && matchSt && matchCe;
    });
  }

  function filterCourses() {
    renderCourses(getFiltered());
  }

  // ── Render ────────────────────────────────────────────────────
  function renderCourses(courses) {
    const list = document.getElementById('course-list');
    const empty = document.getElementById('empty-state');

    if (!courses.length) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');

    list.innerHTML = courses.map(c => {
      const id = c._id || c.id;
      const slug = c.slug || '';
      const published = c.isPublished || c.status === 'published';
      const code = c.courseCode || c.code || '—';
      const ce = c.ceHours || '—';
      const activeUrl = getActiveUrl(c);
      const enrollments = c.enrollmentCount ?? '—';

      return `
      <div class="course-row px-6 py-4 border-b border-gray-100 grid grid-cols-12 gap-3 items-center last:border-0">
        <div class="col-span-4 min-w-0">
          <p class="font-medium text-gray-900 text-sm truncate" title="${c.title}">${c.title}</p>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="text-xs text-gray-400">${code}</span>
            <span class="text-gray-300">·</span>
            <span class="text-xs text-gray-400">${enrollments} enrolled</span>
          </div>
        </div>
        <div class="col-span-1">
          <span class="text-sm font-semibold text-gray-700">${ce}</span>
          <span class="text-xs text-gray-400 block">CE hrs</span>
        </div>
        <div class="col-span-1">
          <span class="pill ${published ? 'pill-published' : 'pill-draft'}">
            ${published ? '● Live' : '○ Draft'}
          </span>
        </div>
        <div class="col-span-3">
          <div class="flex items-center gap-1.5 bg-gray-50 border border-gray-200 rounded-lg px-2 py-1.5">
            <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            <span class="text-xs text-gray-600 truncate flex-1 font-mono">${activeUrl.replace(CLIENT_BASE,'')}</span>
          </div>
        </div>
        <div class="col-span-2 flex gap-1.5">
          <button id="copy-${id}" onclick="copyLink('${id}')"
            class="copy-btn flex-1 py-1.5 border border-gray-300 text-gray-700 rounded-lg text-xs font-medium hover:bg-gray-50">
            Copy
          </button>
          <a href="${urls.detail(c)}" target="_blank"
            class="flex items-center justify-center w-8 h-8 border border-gray-300 rounded-lg text-gray-500 hover:bg-gray-50" title="Preview">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </a>
        </div>
        <div class="col-span-1">
          <button onclick="openQR('${id}')"
            class="flex items-center justify-center w-8 h-8 border border-gray-300 rounded-lg text-gray-500 hover:border-burgundy-800 hover:text-burgundy-800" title="QR Code">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke-width="1.5"/><path d="M14 14h2v2h-2zm4 0h3v3h-3zm-4 4h3v3h-3zm4 3v-3h3v3" stroke-width="1.5"/></svg>
          </button>
        </div>
      </div>`;
    }).join('');
  }

  // ── Load courses ──────────────────────────────────────────────
  async function loadCourses() {
    try {
      const token = localStorage.getItem('token') || localStorage.getItem('authToken');
      const headers = token ? { Authorization: `Bearer ${token}` } : {};

      const res = await fetch(`${API_BASE}/admin/courses`, { headers });
      if (!res.ok) throw new Error(`${res.status}`);
      const data = await res.json();
      allCourses = Array.isArray(data) ? data : (data.courses || data.data || []);

      // Stats
      document.getElementById('stat-total').textContent = allCourses.length;
      document.getElementById('stat-published').textContent = allCourses.filter(c => c.isPublished || c.status === 'published').length;

      // Load enrollment counts
      loadEnrollmentStats(headers);

      renderCourses(allCourses);
    } catch (err) {
      document.getElementById('course-list').innerHTML = `
        <div class="px-6 py-12 text-center text-sm text-gray-500">
          <p class="font-medium text-gray-700 mb-1">Could not load courses</p>
          <p class="text-xs text-gray-400">${err.message} — make sure you're logged in as admin</p>
          <button onclick="loadCourses()" class="mt-3 px-4 py-2 bg-burgundy-800 text-white text-xs rounded-lg">Retry</button>
        </div>`;
    }
  }

  async function loadEnrollmentStats(headers) {
    try {
      const [statRes, progRes] = await Promise.all([
        fetch(`${API_BASE}/admin/stats`, { headers }),
        fetch(`${API_BASE}/admin/enrollment-stats`, { headers }).catch(() => null)
      ]);

      if (statRes.ok) {
        const stats = await statRes.json();
        // Try known field names from admin.js stats endpoint
        const enroll = stats.totalEnrollments ?? stats.enrollments ?? stats.activeEnrollments ?? '—';
        const complete = stats.completions ?? stats.completedCourses ?? stats.courseCompletions ?? '—';
        document.getElementById('stat-enrollments').textContent = enroll;
        document.getElementById('stat-completions').textContent = complete;
      }
    } catch (e) {
      // silent — stats cards remain —
    }
  }

  // ── Enrollment wiring health check ───────────────────────────
  async function runWiringCheck() {
    const btn = document.getElementById('wiring-btn');
    btn.textContent = 'Checking…';
    btn.disabled = true;

    const token = localStorage.getItem('token') || localStorage.getItem('authToken');
    const headers = { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) };

    const checks = [
      { label: 'Admin stats endpoint',     url: `${API_BASE}/admin/stats` },
      { label: 'Enrollment search',        url: `${API_BASE}/admin/enrollments/search?limit=1` },
      { label: 'Interactive courses list', url: `${API_BASE}/interactive-courses?limit=1` },
      { label: 'Analytics endpoint',       url: `${API_BASE}/analytics/overview` },
    ];

    const results = await Promise.all(checks.map(async chk => {
      try {
        const r = await fetch(chk.url, { headers });
        return { label: chk.label, ok: r.ok || r.status === 401, status: r.status };
      } catch {
        return { label: chk.label, ok: false, status: 'ERR' };
      }
    }));

    const container = document.getElementById('wiring-checks');
    container.innerHTML = results.map(r => `
      <div class="flex items-center gap-1.5 rounded-lg px-2 py-1 ${r.ok ? 'bg-green-100' : 'bg-red-100'}">
        <span>${r.ok ? '✓' : '✗'}</span>
        <span class="${r.ok ? 'text-green-800' : 'text-red-800'} font-medium">${r.label}</span>
        <span class="ml-auto text-gray-500 font-mono">${r.status}</span>
      </div>`).join('');

    btn.textContent = 'Recheck';
    btn.disabled = false;
  }

  // ── Auth guard ────────────────────────────────────────────────
  (async function() {
    const token = localStorage.getItem('token') || localStorage.getItem('authToken');
    if (!token) { window.location.href = '/login.html'; return; }
    try {
      const res = await fetch(`${API_BASE}/auth/me`, {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      if (!res.ok) { window.location.href = '/login.html'; return; }
      const data = await res.json();
      const user = data.user || data;
      if (user.role !== 'admin') { window.location.href = '/dashboard.html'; return; }
    } catch (e) {
      window.location.href = '/login.html'; return;
    }
  })();

  // ── Init ──────────────────────────────────────────────────────
  loadCourses();

  // Show wiring check placeholder
  document.getElementById('wiring-checks').innerHTML = `
    <div class="col-span-4 text-xs text-gray-500 italic">Click "Check Now" to test enrollment endpoint wiring</div>`;
</script>
<script src="/js/cr-icons.js"></script>
</body>
</html>


