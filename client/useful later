  <script>
    const API = location.hostname === 'localhost' ? 'http://localhost:5000' : 'https://api.counselorready.com';
    const T = localStorage.getItem('token');
    if (!T) location.href = '/login.html';

    // Set user avatar from JWT
    try {
      const p = JSON.parse(atob(T.split('.')[1]));
      document.getElementById('userName').textContent = p.name || '';
      document.getElementById('userAvatar').textContent = (p.name || '--').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    } catch (e) {}

    // ── Helpers ──
    function esc(str) {
      if (!str) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function copyLink(url, btnId) {
      navigator.clipboard.writeText(url).then(() => {
        const btn = document.getElementById(btnId);
        btn.innerHTML = '<i class="fas fa-check text-xs"></i> Copied!';
        btn.classList.add('bg-green-100', 'text-green-700');
        btn.classList.remove('bg-burgundy-50', 'text-burgundy-800');
        setTimeout(() => {
          btn.innerHTML = '<i class="fas fa-copy text-xs"></i> Copy';
          btn.classList.remove('bg-green-100', 'text-green-700');
          btn.classList.add('bg-burgundy-50', 'text-burgundy-800');
        }, 2000);
      });
    }

    // ── Init ──
    document.addEventListener('DOMContentLoaded', init);

    async function init() {
      try {
        let partner = null;
        let stats = null;
        let onboarding = null;

        // Try fetching partner data (partner_admin flow)
        try {
          const res = await fetch(`${API}/api/partners/my`, {
            headers: { 'Authorization': `Bearer ${T}` }
          });
          if (res.ok) {
            const data = await res.json();
            partner = data.partner;
          }
        } catch (e) {}

        if (!partner) {
          document.getElementById('loading').classList.add('hidden');
          document.getElementById('emptyState').classList.remove('hidden');
          return;
        }

        // Fetch stats and onboarding in parallel
        const [statsRes, onboardingRes] = await Promise.all([
          fetch(`${API}/api/partners/my/stats`, {
            headers: { 'Authorization': `Bearer ${T}` }
          }).catch(() => null),
          fetch(`${API}/api/partners/my/onboarding`, {
            headers: { 'Authorization': `Bearer ${T}` }
          }).catch(() => null)
        ]);

        if (statsRes && statsRes.ok) {
          stats = await statsRes.json();
        }
        if (onboardingRes && onboardingRes.ok) {
          onboarding = await onboardingRes.json();
        }

        render(partner, stats, onboarding);
      } catch (err) {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('errorMessage').textContent = err.message || 'Failed to load partner data';
        document.getElementById('errorState').classList.remove('hidden');
      }
    }

    function render(partner, stats, onboarding) {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('content').classList.remove('hidden');

      // ── Partner Header ──
      const logoHtml = partner.branding?.logoUrl
        ? `<img src="${esc(partner.branding.logoUrl)}" alt="${esc(partner.name)}" class="h-12 w-auto rounded-lg">`
        : `<div class="w-12 h-12 rounded-lg flex items-center justify-center text-white font-bold text-xl" style="background:${esc(partner.branding?.primaryColor || '#6b1d34')}">${esc(partner.name.charAt(0))}</div>`;

      document.getElementById('partnerHeader').innerHTML = `
        ${logoHtml}
        <div>
          <h2 class="font-display text-2xl font-bold text-burgundy-800">${esc(partner.branding?.companyName || partner.name)}</h2>
          <p class="text-sm text-stone-500">${esc(partner.branding?.tagline || 'Whitelabel Partner Dashboard')}</p>
        </div>
      `;

      // ── Onboarding Banner ──
      if (onboarding && onboarding.progress && !onboarding.progress.allRequiredDone) {
        const pct = onboarding.progress.percentage || 0;
        document.getElementById('onboardingBanner').innerHTML = `
          <a href="/partner/onboarding" class="bg-white rounded-xl border border-amber-200 p-4 flex items-center gap-4 hover:shadow-md transition-shadow block" style="background:#fffbeb">
            <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:#fef3c7">
              <i class="fas fa-rocket text-amber-600"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-stone-900">Finish setting up your account</p>
              <p class="text-xs text-stone-500 mt-0.5">${onboarding.progress.requiredCompleted || 0} of ${onboarding.progress.requiredTotal || 0} steps completed</p>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-16 bg-stone-200 rounded-full h-1.5">
                <div class="h-1.5 rounded-full" style="width:${pct}%;background:#d97706"></div>
              </div>
              <i class="fas fa-arrow-right text-stone-400 text-sm"></i>
            </div>
          </a>
        `;
        document.getElementById('onboardingBanner').classList.remove('hidden');
      }

      // ── Stat Cards ──
      document.getElementById('statsGrid').innerHTML = `
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-burgundy-50">
              <i class="fas fa-users text-burgundy-800"></i>
            </div>
            <div>
              <p class="text-2xl font-bold text-stone-900">${stats?.totalUsers ?? partner.userCount ?? 0}</p>
              <p class="text-xs text-stone-500">Total Users</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:#f0fdf4">
              <i class="fas fa-chart-line text-hunter-500"></i>
            </div>
            <div>
              <p class="text-2xl font-bold text-stone-900">${stats?.activeUsers ?? (partner.active ? 'Active' : 'Paused')}</p>
              <p class="text-xs text-stone-500">${stats ? 'Active (30d)' : 'Partner Status'}</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:#eff6ff">
              <i class="fas fa-book-open" style="color:#2563eb"></i>
            </div>
            <div>
              <p class="text-2xl font-bold text-stone-900">${stats?.coursesCompleted ?? '--'}</p>
              <p class="text-xs text-stone-500">Courses Completed</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:#fef3c7">
              <i class="fas fa-award" style="color:#d97706"></i>
            </div>
            <div>
              <p class="text-2xl font-bold text-stone-900">${stats?.ceHoursEarned ?? '--'}</p>
              <p class="text-xs text-stone-500">CE Hours Earned</p>
            </div>
          </div>
        </div>
      `;

      // ── Recent Activity Banner ──
      if (stats?.recentEnrollments > 0) {
        document.getElementById('recentActivity').innerHTML = `
          <div class="bg-white rounded-xl border border-green-200 p-4 flex items-center gap-3" style="background:#f0fdf4">
            <i class="fas fa-chart-line text-hunter-500"></i>
            <p class="text-sm text-stone-700">
              <span class="font-bold text-hunter-500">${stats.recentEnrollments}</span> new enrollment${stats.recentEnrollments !== 1 ? 's' : ''} in the last 7 days
            </p>
          </div>
        `;
        document.getElementById('recentActivity').classList.remove('hidden');
      }

      // ── Distribution Links ──
      const origin = window.location.origin;
      const registerUrl = `${origin}/register?partner=${partner.slug}`;
      const loginUrl = `${origin}/login?partner=${partner.slug}`;
      document.getElementById('distributionLinks').innerHTML = `
        <h2 class="text-sm font-semibold text-stone-900 mb-3">Your Distribution Links</h2>
