<script>
const API=location.hostname==='localhost'?'http://localhost:5000':'https://api.counselorready.com';
const T=localStorage.getItem('token');
if(!T)location.href='/login.html';

try{const p=JSON.parse(atob(T.split('.')[1]));
document.getElementById('userName').textContent=p.name||'';
document.getElementById('userAvatar').textContent=(p.name||'--').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
}catch(e){}

let credentials=[],editingId=null;

const STATUS_CFG={
  not_started:{label:'Not Started',bg:'#f3f4f6',color:'#374151',icon:'fa-circle'},
  gathering_docs:{label:'Gathering Docs',bg:'#dbeafe',color:'#1d4ed8',icon:'fa-file-lines'},
  submitted:{label:'Submitted',bg:'#e0e7ff',color:'#4338ca',icon:'fa-paper-plane'},
  under_review:{label:'Under Review',bg:'#fef3c7',color:'#92400e',icon:'fa-clock'},
  approved:{label:'Approved',bg:'#d1fae5',color:'#065f46',icon:'fa-circle-check'},
  denied:{label:'Denied',bg:'#fee2e2',color:'#991b1b',icon:'fa-circle-xmark'},
  recredentialing:{label:'Recredentialing',bg:'#f3e8ff',color:'#7c3aed',icon:'fa-rotate'}
};

const DEFAULT_CHECKLIST=[
  {name:'W-9 Form',required:true,uploaded:false},
  {name:'State License Copy',required:true,uploaded:false},
  {name:'Malpractice Insurance Certificate',required:true,uploaded:false},
  {name:'NPI Verification',required:true,uploaded:false},
  {name:'CAQH Profile Updated',required:true,uploaded:false},
  {name:'Diploma / Transcripts',required:false,uploaded:false},
  {name:'Board Certification',required:false,uploaded:false},
  {name:'DEA Registration (if applicable)',required:false,uploaded:false}
];

async function init(){
  try{
    const r=await fetch(`${API}/api/insurance-credentials`,{headers:{Authorization:`Bearer ${T}`}});
    if(!r.ok)throw new Error('Failed to load');
    credentials=await r.json();
    document.getElementById('loading').style.display='none';
    document.getElementById('content').classList.remove('hidden');
    if(!credentials.length){document.getElementById('emptyState').classList.remove('hidden');return;}
    renderStatusCards();renderPanels();
  }catch(e){document.getElementById('loading').innerHTML='<p style="color:#6B1D34;font-weight:600">'+e.message+'</p>';}
}

function renderStatusCards(){
  const counts={};
  credentials.forEach(c=>{counts[c.applicationStatus]=(counts[c.applicationStatus]||0)+1;});
  const important=['approved','under_review','submitted','not_started'];
  document.getElementById('statusCards').innerHTML=important.map(s=>{
    const cfg=STATUS_CFG[s]||STATUS_CFG.not_started;
    return`<div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
      <p class="text-2xl font-bold font-display" style="color:${cfg.color}">${counts[s]||0}</p>
      <p class="text-xs text-gray-500 mt-1">${cfg.label}</p>
    </div>`;
  }).join('');
}

function renderPanels(){
  const el=document.getElementById('panelsList');
  if(!credentials.length){el.innerHTML='';document.getElementById('emptyState').classList.remove('hidden');return;}
  document.getElementById('emptyState').classList.add('hidden');
  el.innerHTML=credentials.map((c,i)=>{
    const cfg=STATUS_CFG[c.applicationStatus]||STATUS_CFG.not_started;
    const checklist=c.documentsChecklist||[];
    const done=checklist.filter(d=>d.uploaded).length;
    return`<div class="bg-white rounded-xl border border-gray-200 mb-4 overflow-hidden">
      <button onclick="togglePanel(${i})" class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-stone-50 transition-colors">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background:${cfg.bg}"><i class="fas ${cfg.icon}" style="color:${cfg.color}"></i></div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-gray-800 truncate">${c.insuranceCompany}</p>
            <p class="text-xs text-gray-400 mt-0.5">${c.panelType==='in_network'?'In-Network':'Out-of-Network'} &middot; Docs: ${done}/${checklist.length}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold" style="background:${cfg.bg};color:${cfg.color}">${cfg.label}</span>
          <i class="fas fa-chevron-down chevron-icon text-gray-400" id="chev${i}"></i>
        </div>
      </button>
      <div class="panel-details" id="detail${i}">
        <div class="px-5 pb-5 border-t border-gray-100 pt-4">
          <div class="grid grid-cols-2 gap-4 text-sm mb-4">
