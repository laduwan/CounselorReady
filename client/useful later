            <code class="flex-1 text-xs bg-stone-50 px-3 py-2 rounded-lg text-stone-700 border border-stone-200 truncate">${esc(registerUrl)}</code>
            <button id="copyRegBtn" onclick="copyLink('${registerUrl}','copyRegBtn')"
              class="flex items-center gap-1 px-3 py-2 text-xs font-medium rounded-lg bg-burgundy-50 text-burgundy-800 transition-colors hover:bg-burgundy-100">
              <i class="fas fa-copy text-xs"></i> Copy
