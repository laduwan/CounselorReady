    docs=docsR.ok?await docsR.json():[];
    contacts=contactsR.ok?await contactsR.json():[];

    document.getElementById('statDocs').textContent=summary.documentCount||docs.length||0;
    document.getElementById('statContacts').textContent=summary.contactCount||contacts.length||0;
    document.getElementById('statPlan').textContent=summary.planStatus||'Not started';
    document.getElementById('statCheckin').textContent=summary.lastCheckIn?new Date(summary.lastCheckIn).toLocaleDateString():'Never';

    document.getElementById('loading').style.display='none';
    document.getElementById('content').classList.remove('hidden');
    renderDocs();renderContacts();
    loadPlan();
  }catch(e){document.getElementById('loading').innerHTML='<p style="color:#6B1D34;font-weight:600">'+e.message+'</p>';}
}

function switchTab(tab){
  ['docs','contacts','plan'].forEach(t=>{
    document.getElementById('panel'+t.charAt(0).toUpperCase()+t.slice(1)).classList.toggle('hidden',t!==tab);
    document.getElementById('tab'+t.charAt(0).toUpperCase()+t.slice(1)).classList.toggle('active',t===tab);
  });
}

function renderDocs(){
  const el=document.getElementById('docsList');
  if(!docs.length){el.innerHTML='<div class="text-center py-12 bg-white rounded-xl border border-gray-200"><p class="text-gray-400 text-sm">No documents uploaded yet.</p></div>';return;}
  el.innerHTML='<div class="bg-white rounded-xl border border-gray-200 overflow-hidden divide-y divide-gray-50">'+docs.map(d=>{
    const cat=CATEGORY_LABELS[d.category]||d.category;
    const size=d.fileSize?formatBytes(d.fileSize):'';
    return`<div class="px-5 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-9 h-9 rounded-lg bg-burgundy-50 flex items-center justify-center flex-shrink-0"><i class="fas fa-file text-burgundy-400"></i></div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-gray-800 truncate">${d.originalName||d.fileName||'Document'}</p>
          <p class="text-xs text-gray-400">${cat} ${size?' &middot; '+size:''} &middot; ${new Date(d.createdAt||d.uploadedAt).toLocaleDateString()}</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href="${API}/api/legacy-vault/documents/${d._id}/serve" target="_blank" class="px-2 py-1 text-xs text-hunter-500 hover:bg-hunter-100 rounded"><i class="fas fa-download"></i></a>
        <button onclick="deleteDoc('${d._id}')" class="px-2 py-1 text-xs text-red-400 hover:bg-red-50 rounded"><i class="fas fa-trash"></i></button>
      </div>
    </div>`;
  }).join('')+'</div>';
}

function renderContacts(){
  const el=document.getElementById('contactsList');
  if(!contacts.length){el.innerHTML='<div class="text-center py-12 bg-white rounded-xl border border-gray-200"><p class="text-gray-400 text-sm">No emergency contacts added yet.</p></div>';return;}
  el.innerHTML=contacts.map(c=>{
    const role=ROLE_LABELS[c.role]||c.role;
    const access=ACCESS_LABELS[c.accessLevel]||c.accessLevel;
    return`<div class="bg-white rounded-xl border border-gray-200 p-5 mb-3">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-semibold text-gray-800">${c.name}</p>
          <p class="text-xs text-gray-500 mt-0.5">${role} &middot; ${access}</p>
          ${c.email?'<p class="text-xs text-gray-400 mt-1"><i class="fas fa-envelope mr-1"></i>'+c.email+'</p>':''}
          ${c.phone?'<p class="text-xs text-gray-400"><i class="fas fa-phone mr-1"></i>'+c.phone+'</p>':''}
          ${c.notes?'<p class="text-xs text-gray-400 mt-1">'+c.notes+'</p>':''}
        </div>
        <button onclick="deleteContact('${c._id}')" class="text-gray-300 hover:text-red-500"><i class="fas fa-trash text-xs"></i></button>
      </div>
    </div>`;
  }).join('');
}

async function loadPlan(){
  try{
    const r=await fetch(`${API}/api/legacy-vault/plan`,{headers:{Authorization:`Bearer ${T}`}});
    if(r.ok){plan=await r.json();
      if(plan.practiceType)document.getElementById('pType').value=plan.practiceType;
      if(plan.clientNotificationPlan)document.getElementById('pClients').value=plan.clientNotificationPlan;
      if(plan.recordsTransferPlan)document.getElementById('pRecords').value=plan.recordsTransferPlan;
      if(plan.financialArrangements)document.getElementById('pFinancial').value=plan.financialArrangements;
      if(plan.checkInIntervalDays)document.getElementById('pInterval').value=plan.checkInIntervalDays;
    }
  }catch(e){}
}

function toggleUpload(){document.getElementById('uploadForm').classList.toggle('hidden');}
function toggleContactForm(){document.getElementById('contactForm').classList.toggle('hidden');}

async function uploadDoc(e){
  e.preventDefault();
  const fd=new FormData();
  fd.append('file',document.getElementById('docFile').files[0]);
  fd.append('category',document.getElementById('docCat').value);
  fd.append('notes',document.getElementById('docNotes').value);
  try{
    const r=await fetch(`${API}/api/legacy-vault/documents`,{method:'POST',headers:{Authorization:`Bearer ${T}`},body:fd});
    if(!r.ok)throw new Error('Upload failed');
    const d=await r.json();docs.push(d);
    toggleUpload();renderDocs();
    document.getElementById('statDocs').textContent=docs.length;
    showToast('Document uploaded','success');
  }catch(e){showToast(e.message,'error');}
}

async function deleteDoc(id){
  if(!confirm('Delete this document?'))return;
  try{
    await fetch(`${API}/api/legacy-vault/documents/${id}`,{method:'DELETE',headers:{Authorization:`Bearer ${T}`}});
    docs=docs.filter(d=>d._id!==id);renderDocs();
    document.getElementById('statDocs').textContent=docs.length;
    showToast('Document deleted','success');
  }catch(e){showToast('Failed to delete','error');}
}

async function saveContact(e){
  e.preventDefault();
  const body={name:document.getElementById('cName').value,email:document.getElementById('cEmail').value,phone:document.getElementById('cPhone').value,role:document.getElementById('cRole').value,accessLevel:document.getElementById('cAccess').value,notes:document.getElementById('cNotes').value};
  try{
    const r=await fetch(`${API}/api/legacy-vault/contacts`,{method:'POST',headers:{Authorization:`Bearer ${T}`,'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!r.ok)throw new Error('Failed');
    const d=await r.json();contacts.push(d);
    toggleContactForm();renderContacts();
    document.getElementById('statContacts').textContent=contacts.length;
    showToast('Contact added','success');
  }catch(e){showToast(e.message,'error');}
}

async function deleteContact(id){
  if(!confirm('Remove this contact?'))return;
  try{
    await fetch(`${API}/api/legacy-vault/contacts/${id}`,{method:'DELETE',headers:{Authorization:`Bearer ${T}`}});
    contacts=contacts.filter(c=>c._id!==id);renderContacts();
    document.getElementById('statContacts').textContent=contacts.length;
  }catch(e){showToast('Failed','error');}
}

async function savePlan(e){
  e.preventDefault();
  const body={practiceType:document.getElementById('pType').value,clientNotificationPlan:document.getElementById('pClients').value,recordsTransferPlan:document.getElementById('pRecords').value,financialArrangements:document.getElementById('pFinancial').value,checkInIntervalDays:parseInt(document.getElementById('pInterval').value)};
  try{
    const r=await fetch(`${API}/api/legacy-vault/plan`,{method:'PUT',headers:{Authorization:`Bearer ${T}`,'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!r.ok)throw new Error('Failed');
    showToast('Plan saved','success');
    document.getElementById('statPlan').textContent='Configured';
  }catch(e){showToast(e.message,'error');}
}

async function checkIn(){
  try{
    const r=await fetch(`${API}/api/legacy-vault/checkin`,{method:'POST',headers:{Authorization:`Bearer ${T}`,'Content-Type':'application/json'}});
    if(!r.ok)throw new Error('Failed');
    document.getElementById('statCheckin').textContent=new Date().toLocaleDateString();
    showToast('Check-in recorded','success');
  }catch(e){showToast(e.message,'error');}
}

function formatBytes(b){if(!b)return'';const k=1024;const s=['B','KB','MB'];const i=Math.floor(Math.log(b)/Math.log(k));return(b/Math.pow(k,i)).toFixed(1)+' '+s[i];}

function showToast(msg,type){
  const t=document.getElementById('toast');t.textContent=msg;
  t.style.background=type==='error'?'#fee2e2':'#d1fae5';
  t.style.color=type==='error'?'#991b1b':'#065f46';
  t.classList.remove('hidden');setTimeout(()=>t.classList.add('hidden'),3000);
}

document.addEventListener('DOMContentLoaded',init);
</script>
