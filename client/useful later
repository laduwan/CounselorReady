<script>
  const NBCC_AREAS = [
    'Counseling Theory/Practice',
    'Human Growth and Development',
    'Social and Cultural Foundations',
    'Group Dynamics',
    'Career Development',
    'Assessment',
    'Research/Program Evaluation',
    'Professional Identity',
    'Wellness and Prevention'
  ];

  // Build checkboxes once
  (function() {
    const container = document.getElementById('metaContentAreas');
    container.innerHTML = NBCC_AREAS.map((area, i) => `
      <label style="display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:8px;background:#F8F7F4;cursor:pointer;font-size:12px;color:#2C2C2C">
        <input type="checkbox" name="nbccArea" value="${area}" 
          style="accent-color:#4A7C59;width:16px;height:16px;cursor:pointer"
          onchange="limitContentAreas(this)">
        ${area}
      </label>
    `).join('');
  })();

  function limitContentAreas(el) {
    const checked = document.querySelectorAll('input[name=nbccArea]:checked');
    if (checked.length > 3) {
      el.checked = false;
      showToast('Max 3 content areas', '#b8893f');
    }
  }

  function openMetaModal(courseId, title) {
    document.getElementById('metaCourseId').value = courseId;
    document.getElementById('metaModalTitle').textContent = title;

    // Find course data
    const course = allCourses.find(c => c._id === courseId);
    if (course) {
      document.getElementById('metaDeliveryFormat').value = course.deliveryFormat || 'async';
      document.getElementById('metaAccessType').value = course.accessType || 'subscription';
      document.getElementById('metaApprovalBody').value = course.approvalBody || course.approvingBody || 'NBCC';
      document.getElementById('metaLevel').value = course.level || course.difficulty || 'Intermediate';

      // Check content area boxes
      const areas = course.nbccContentAreas || [];
      document.querySelectorAll('input[name=nbccArea]').forEach(cb => {
        cb.checked = areas.includes(cb.value);
      });
    }

    const modal = document.getElementById('metaModal');
    modal.style.display = 'flex';
  }

  function closeMetaModal() {
    document.getElementById('metaModal').style.display = 'none';
  }

  async function saveMetadata() {
    const courseId = document.getElementById('metaCourseId').value;
    const btn = document.getElementById('metaSaveBtn');
    btn.textContent = 'Saving...';
    btn.disabled = true;

    const checkedAreas = Array.from(document.querySelectorAll('input[name=nbccArea]:checked')).map(cb => cb.value);

    const payload = {
      deliveryFormat: document.getElementById('metaDeliveryFormat').value,
      accessType: document.getElementById('metaAccessType').value,
      approvalBody: document.getElementById('metaApprovalBody').value,
      level: document.getElementById('metaLevel').value,
      nbccContentAreas: checkedAreas
    };

    try {
      const r = await fetch(`${API_URL}/api/interactive-courses/${courseId}/metadata`, {
        method: 'PATCH',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!r.ok) {
        const d = await r.json();
        throw new Error(d.error || 'Save failed');
      }

      showToast('Metadata saved', '#4A7C59');
      closeMetaModal();
      loadCourses(); // Refresh cards
    } catch(e) {
      showToast('Error: ' + e.message, '#dc2626');
    } finally {
      btn.textContent = 'Save';
      btn.disabled = false;
    }
  }

  // Close modal on backdrop click
  document.getElementById('metaModal').addEventListener('click', function(e) {
    if (e.target === this) closeMetaModal();
  });
</script>

