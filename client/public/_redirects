# Block sensitive paths (MUST come before catch-all)
/.env           /404.html    404
/.env.*         /404.html    404
/.git/*         /404.html    404
/wp-admin       /404.html    404
/wp-admin/*     /404.html    404
/wp-login*      /404.html    404
/api/debug      /404.html    404
/api/debug/*    /404.html    404

# Serve static HTML pages directly (bypass SPA catch-all)
/admin.html              /admin.html              200
/admin-*.html            /admin-*.html            200
/about.html              /about.html              200
/tools/*                 /tools/:splat            200

# SPA catch-all (must be LAST)
/*    /index.html   200
